+def _omni_static_page(name: str):
+    """Serve a site page from the frontend build, then the backend static dir."""
+    for candidate in (
+        FRONTEND_BUILD_DIR / 'static' / name,
+        STATIC_DIR / name,
+    ):
+        if candidate.is_file():
+            return FileResponse(candidate)
+    raise HTTPException(status_code=404, detail='Page not found')
+
+
