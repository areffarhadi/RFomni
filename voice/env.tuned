# The settings this version's measured performance was taken with.
# Copy to .env before launching:  cp env.tuned .env
# .env itself is never committed — it is per-host.

# Qwen3-Omni Pipecat local voice agent
OMNI_UI_TITLE="RFomni Playground V5.3"
OMNI_BASE_URL=http://127.0.0.1:8410/v1
OMNI_MODEL=voice
OMNI_MODE=assistant
OMNI_MAX_TOKENS=200
# V5.3: speech *start* still uses Silero VADIterator (same as V5.2). End-of-turn is
# Local Smart Turn v3 (ONNX), not SpeechTimeout. OMNI_VAD_ENGINE=silero still A/Bs the
# start detector back to V5.1's SileroVADAnalyzer. For silence-timeout end-of-turn, use
# the V5.2 agent instead of this tree.
OMNI_VAD_ENGINE=vaditerator
OMNI_VAD_ITER_MIN_SILENCE_MS=100
OMNI_VAD_STOP_SECS=0.4
# Smart Turn v3 (stop). Defaults match pipecat SmartTurnParams.
OMNI_SMART_TURN_STOP_SECS=3.0
OMNI_SMART_TURN_PRE_SPEECH_MS=500
OMNI_SMART_TURN_MAX_DURATION_SECS=8.0
OMNI_SMART_TURN_CPU_COUNT=1
# OMNI_SMART_TURN_MODEL_PATH=   # blank = bundled smart-turn-v3.2-cpu.onnx
OMNI_PREROLL_SECS=1.5
OMNI_RNNOISE=0
OMNI_CONTEXT_TURNS=12
OMNI_MAX_CONCURRENT_TURNS=8
OMNI_TURN_QUEUE_TIMEOUT=120
OMNI_HTTP_MAX_CONNECTIONS=32
OMNI_VISION=1
OMNI_AVATAR_WIDTH=512
OMNI_AVATAR_HEIGHT=512
# Optional Simli talking avatar (natural lip-sync). Without these, a local
# procedural face fills the Bot Video panel so video plumbing still works.
# SIMLI_API_KEY=
# SIMLI_FACE_ID=cace3ef7-a4c4-425d-a8cf-a5358eb0c427
LOG_LEVEL=INFO
OMNI_AVATAR=none
OMNI_SPEAKER=ethan

# --- goal-speaker recognition (V5.1: ECAPA-512 ONNX on CPU) ------------------------
# Embedder: RFomni-ASV's service with SPK_MODEL=ecapa512, SPK_BACKEND=onnx, no CUDA.
# 192-dim, 8 ms per 2.5 s clip of pure compute; measured here at 28 ms per 3 s utterance
# end to end, against 29 ms for samresnet34 on the GPU — at one call per turn the cost is
# HTTP and kernel-launch overhead, not the model, so the card bought nothing.
#
# THRESHOLD: 0.35, the same number V4/V5 ran SamResNet34 at, kept across the model swap
# by decision rather than by derivation.
#
# What the live data says, session 717f1e1a on 2026-09-17, six turns all from the owner:
# 0.182, 0.193, 0.341, 0.382, 0.436, 0.550. At 0.35 that admits three of six. The shipped
# 0.50 admitted one. Nothing admits all six safely — the two lowest sit below the 0.206 a
# different VoxCeleb speaker scores against this owner, so buying them costs impostors
# too. 0.33 would add the 0.341 turn if the misses become annoying.
#
# The spread is the model, not the setting: ecapa512 keeps a 0.327 benchmark margin
# against SamResNet34's 0.435, and live mic audio eats more than that difference. The
# same owner measured 0.368 and 0.637 on SamResNet34 with a stranger at 0.318. If owner
# turns keep being refused, the fix is SPK_MODEL=samresnet34 (ONNX, still CPU, ~98 ms per
# utterance instead of 8) rather than a lower number here.
#
# Comment this out to take whatever the serving model ships (0.50 for ecapa512).
OMNI_GATE_THRESHOLD=0.35
OMNI_GATE_MIN_ENROLL_S=4.0
# 1 = if the embedder dies mid-call, let turns through rather than lock the owner out.
OMNI_GATE_FAIL_OPEN=1

# Only the enrolled speaker may interrupt the agent mid-sentence. Takes effect once a
# voice is registered; with nobody registered, barge-in is unchanged.
OMNI_BARGE_GATE=1
# Identity is checked at these many seconds of interrupting speech; the agent is cut
# off as soon as one clears the threshold. The first value is the owner's usual
# barge-in latency, the last is how long an unrecognised voice talks before being
# dropped. Measured: 0.7 s admits the owner 5 of 6 times, 2.5 s admits all 6, and an
# impostor never clears the threshold at any of them.
OMNI_BARGE_CHECKPOINTS=0.7,1.5,2.5

# Languages the "EN · DE · FR · ES · PT" policy accepts. Speech outside the set is not
# transcribed into it — the speaker is asked to switch, because a mistranscription into a
# language the speaker did not use is worse than saying no. "Any language" ignores this.
OMNI_LANG_SET=en,de,fr,es,pt

# --- V5.1: the CPU embedder ---------------------------------------------------------
# Its own port, so the GPU service on :8612 can keep serving V4/V5 side by side.
OMNI_GATE_URL=http://127.0.0.1:8613
# Separate overlapping speakers before scoring. NOTE: the diarizer is the one GPU piece
# left, so with it enabled V5.1 is no longer CPU-only. Off by default, and the platform
# skips starting it unless DIARIZER=1.
OMNI_DIARIZE_URL=http://127.0.0.1:8611
OMNI_DIARIZE=0

# --- V5: silent owner capture -----------------------------------------------------
# The owner is taken from the conversation instead of being asked for. The first voice
# heard is the candidate; if one turn is not enough speech, the next turn from the same
# voice is concatenated to it; if a second voice speaks, the third turn decides which of
# the two is the owner and is merged with it. Three turns from three different voices
# means there is no owner to infer, and the attempt restarts. Nothing is spoken and no
# turn is consumed — the only visible effect is that "Only my voice" stops being greyed
# out. 0 restores V4's press-a-button enrolment.
OMNI_AUTO_ENROLL=1
# Cosine at which two turns are called the same person. Unset, it tracks whatever
# threshold the gate ends up on, so it follows a model swap instead of being a constant
# measured against the model you are no longer using. The V5 value 0.38 (itself a live
# correction of 0.45, which never merged anything on a real mic) translates to ~0.39 on
# ecapa512's scale; it is left unset here so both numbers move together — pin it if you
# want merging looser or tighter than admission.
# OMNI_AUTO_MATCH=0.39
# Turns shorter than this are not even embedded: the embedder refuses under ~0.5 s and a
# one-word turn clusters badly, landing near everybody.
OMNI_AUTO_MIN_TURN_S=1.0
# Distinct voices tolerated before the attempt is abandoned and restarted.
OMNI_AUTO_MAX_DISTINCT=3
# Ceiling on audio banked per candidate, so a long unregistered conversation stays bounded.
OMNI_AUTO_MAX_CANDIDATE_S=20.0
