# --- the service ---------------------------------------------------------------------
SPK_BACKEND=onnx                  # onnx | torch | auto
SPK_MODEL_DIR=                    # blank = models/voxblink2_samresnet34_ft in this repo
SPK_DEVICE=cpu                    # cuda:0 with the torch backend, or onnxruntime-gpu
SPK_PORT=8612
SPK_MIN_SECONDS=0.5               # shorter clips are refused rather than scored

# --- the gate client -----------------------------------------------------------------
OMNI_GATE_URL=http://127.0.0.1:8612
OMNI_GATE_THRESHOLD=0.45          # measured; see the table in gate.py before changing
OMNI_GATE_MIN_ENROLL_S=4.0        # minimum speech per enrolment take
OMNI_GATE_FAIL_OPEN=1             # 0 = refuse turns when the embedder is unreachable

# --- barge-in ------------------------------------------------------------------------
OMNI_BARGE_GATE=1                 # 0 = anyone may interrupt
OMNI_BARGE_CHECKPOINTS=0.7,1.5,2.5

# --- optional diarizer ---------------------------------------------------------------
# Leave OMNI_DIARIZE_URL empty and speaker separation disappears cleanly.
OMNI_DIARIZE_URL=
OMNI_DIARIZE=0

# --- model selection -----------------------------------------------------------------
# samresnet34  256-d  EER 0.415%   27.7 s/s on 4 CPU cores   onnx + torch(GPU)  thr 0.45
# ecapa1024    192-d  EER 0.675%  128   s/s                  onnx               thr 0.45
# ecapa512     192-d  EER 0.883%  327   s/s                  onnx               thr 0.50
# The gate adopts the serving model's threshold from /health unless you pin
# OMNI_GATE_THRESHOLD yourself.
SPK_MODEL=samresnet34
